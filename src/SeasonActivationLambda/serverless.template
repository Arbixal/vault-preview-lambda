{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Season activation Lambda for immutable Vault Preview season revisions. This template is partially managed by Amazon.Lambda.Annotations (v2.4.0.0).",
  "Parameters": {
    "VaultPreviewDataBucket": {
      "Type": "String",
      "Default": "vault-preview-data",
      "Description": "Durable S3 bucket containing season revisions and activation state."
    },
    "VaultPreviewSchedulerGroupName": {
      "Type": "String",
      "Default": "vault-preview-season-config",
      "Description": "EventBridge Scheduler group for season activation schedules.",
      "AllowedPattern": "^[A-Za-z0-9_.-]{1,64}$"
    }
  },
  "Resources": {
    "SeasonActivationLambdaFunctionFunctionHandlerGenerated": {
      "Type": "AWS::Serverless::Function",
      "Metadata": {
        "Tool": "Amazon.Lambda.Annotations"
      },
      "Properties": {
        "Runtime": "dotnet10",
        "CodeUri": ".",
        "MemorySize": 256,
        "Timeout": 30,
        "Environment": {
          "Variables": {
            "VAULT_PREVIEW_DATA_BUCKET": {
              "Ref": "VaultPreviewDataBucket"
            }
          }
        },
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          {
            "Statement": {
              "Sid": "SeasonConfigurationObjectAccessStatement",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${VaultPreviewDataBucket}/season-config/*"
              }
            }
          }
        ],
        "PackageType": "Zip",
        "Handler": "SeasonActivationLambda::SeasonActivationLambda.Function_FunctionHandler_Generated::FunctionHandler"
      }
    },
    "SeasonActivationSchedulerDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600
      }
    },
    "SeasonActivationSchedulerGroup": {
      "Type": "AWS::Scheduler::ScheduleGroup",
      "Properties": {
        "Name": {
          "Ref": "VaultPreviewSchedulerGroupName"
        }
      }
    },
    "SeasonActivationSchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeSeasonActivationLambda",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::GetAtt": [
                      "SeasonActivationLambdaFunctionFunctionHandlerGenerated",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "SeasonActivationSchedulerDeadLetterQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ActivationFunctionArn": {
      "Description": "ARN used by EventBridge Scheduler and the configuration CLI.",
      "Value": {
        "Fn::GetAtt": [
          "SeasonActivationLambdaFunctionFunctionHandlerGenerated",
          "Arn"
        ]
      }
    },
    "SchedulerGroupName": {
      "Description": "EventBridge Scheduler group name for dynamic activation schedules.",
      "Value": {
        "Ref": "VaultPreviewSchedulerGroupName"
      }
    },
    "SchedulerGroupArn": {
      "Description": "EventBridge Scheduler group ARN.",
      "Value": {
        "Fn::GetAtt": [
          "SeasonActivationSchedulerGroup",
          "Arn"
        ]
      }
    },
    "SchedulerRoleArn": {
      "Description": "Execution role ARN used by EventBridge Scheduler.",
      "Value": {
        "Fn::GetAtt": [
          "SeasonActivationSchedulerRole",
          "Arn"
        ]
      }
    },
    "SchedulerDeadLetterQueueArn": {
      "Description": "Dead-letter queue ARN for failed activation schedules.",
      "Value": {
        "Fn::GetAtt": [
          "SeasonActivationSchedulerDeadLetterQueue",
          "Arn"
        ]
      }
    }
  }
}